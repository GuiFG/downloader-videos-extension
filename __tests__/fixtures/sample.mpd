<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" minBufferTime="PT1.5S" type="static" mediaPresentationDuration="PT0H0M10S" maxSegmentDuration="PT0H0M4S" profiles="urn:mpeg:dash:profile:isoff-live:2011">
  <!-- Video Adaptation Set -->
  <Period>
    <AdaptationSet mimeType="video/mp4" segmentAlignment="true" subsegmentAlignment="true" subsegmentStartsWithSAP="1">
      <!-- 480p representation -->
      <Representation id="video-480p" bandwidth="500000" width="854" height="480" frameRate="30">
