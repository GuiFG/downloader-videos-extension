      <!-- Portuguese audio -->
      <Representation id="audio-pt" bandwidth="128000" audioSamplingRate="48000" lang="pt">
        <SegmentTemplate media="audio-pt-$Number$.m4s" initialization="audio-init.mp4" timescale="48000" duration="192000" startNumber="1">
          <SegmentTimeline>
