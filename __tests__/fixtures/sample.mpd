    </AdaptationSet>
    
    <!-- Audio Adaptation Set -->
    <AdaptationSet mimeType="audio/mp4" segmentAlignment="true" subsegmentAlignment="true" subsegmentStartsWithSAP="1">
      <!-- English audio -->
      <Representation id="audio-en" bandwidth="128000" audioSamplingRate="48000" lang="en">
